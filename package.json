{
	"name": "fairygui-maker",
	"version": "0.1.0",
	"description": "AI agent toolkit and preview workspace for FairyGUI projects and published artifacts.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/OpenFairyGUI/FairyGUI-Maker.git"
	},
	"homepage": "https://github.com/OpenFairyGUI/FairyGUI-Maker#readme",
	"bugs": {
		"url": "https://github.com/OpenFairyGUI/FairyGUI-Maker/issues"
	},
	"type": "module",
	"files": [
		"dist/",
		"scripts/fairygui-maker.mjs",
		"README.md",
		"LICENSE",
		"docs/",
		"THIRD_PARTY_NOTICES.md",
		"vendor-runtime.lock.json",
		".agents/skills/use-fairygui-maker/",
		".claude/skills/use-fairygui-maker/"
	],
	"bin": {
		"fairygui-maker": "scripts/fairygui-maker.mjs"
	},
	"scripts": {
		"precli": "pnpm build",
		"cli": "node scripts/fairygui-maker.mjs",
		"start": "node scripts/fairygui-maker.mjs",
		"dev:web": "vite",
		"dev:host": "tsx watch src/server/index.ts",
		"typecheck": "tsc --noEmit --pretty false",
		"build:web": "vite build",
		"build:server": "vite build --config vite.server.config.ts",
		"build": "pnpm typecheck && pnpm build:web && pnpm build:server",
		"prepack": "pnpm verify:runtime && pnpm build",
		"pretest": "pnpm build",
		"test": "node --import tsx --test",
		"test:browser": "node --import tsx scripts/browser-smoke.ts",
		"verify:runtime": "node scripts/verify-release-inputs.mjs",
		"verify:release": "pnpm verify:runtime && pnpm test && pnpm test:browser && pnpm audit --prod && node scripts/release-smoke.mjs"
	},
	"dependencies": {
		"@hono/node-server": "2.1.0",
		"@hono/zod-validator": "0.9.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@openfairygui/backend": "0.3.1",
		"@openfairygui/core": "0.3.1",
		"@openfairygui/mcp": "0.3.1",
		"@resvg/resvg-js": "2.6.2",
		"ag-psd": "31.0.2",
		"hono": "4.13.0",
		"openfig-core": "0.4.1",
		"pino": "10.3.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "1.170.20",
		"@tanstack/react-table": "9.0.0",
		"@tanstack/react-virtual": "3.14.9",
		"@types/node": "26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.28.0",
		"playwright": "1.62.1",
		"radix-ui": "1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-resizable-panels": "4.12.2",
		"shadcn": "4.16.1",
		"tailwind-merge": "3.6.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"tsx": "4.23.9",
		"typescript": "7.0.2",
		"vite": "8.2.0"
	},
	"engines": {
		"node": ">=22.18"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.14.0"
}
